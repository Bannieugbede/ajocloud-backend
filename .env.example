NODE_ENV=development
APP_NAME=Ajo Cloud API
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info
DATABASE_URL=postgresql://ajocloud:local_only_change_me@localhost:5432/ajocloud?schema=public
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://ajocloud:local_only_change_me@localhost:5672
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
TOKEN_PEPPER=replace-with-at-least-32-random-characters
JWT_REFRESH_TTL_SECONDS=2592000
IDEMPOTENCY_TTL_SECONDS=86400
AWS_REGION=af-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PAYMENT_PROVIDER=mock
BILL_PAYMENT_PROVIDER=mock
DEFAULT_CURRENCY=NGN
APPLICATION_TIMEZONE=Africa/Lagos
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
MONNIFY_BASE_URL=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WEBHOOK_SECRET=
KYC_PROVIDER=mock
DOJAH_BASE_URL=
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Email delivery: console (logs only) or resend
EMAIL_PROVIDER=console
RESEND_BASE_URL=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=Ajo Cloud
# No hosted SMS provider is wired yet; mock logs instead of sending.
SMS_PROVIDER=mock
# Expo push accepts unauthenticated sends for its own tokens, so no key is needed.
PUSH_PROVIDER=mock
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_MONITORING_DSN=
SWAGGER_ENABLED=true
