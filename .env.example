NODE_ENV=development
APP_NAME=Ajo Cloud API
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3001
# Accept http(s)://localhost:<any port> for local web dev. Ignored in production.
CORS_ALLOW_LOOPBACK=true
# Set true when the web app and API are on different sites (cross-site cookies).
# Requires HTTPS on both, since SameSite=None implies Secure.
SESSION_COOKIE_SAMESITE_NONE=false
# Optional shared parent domain. Leave unset unless needed, e.g. .mirumversal.com
# SESSION_COOKIE_DOMAIN=
# Optional 32+ char secret used only to sign cookie values. Leave unset or omit.
# COOKIE_SECRET=
LOG_LEVEL=info
DATABASE_URL=postgresql://ajocloud:local_only_change_me@localhost:5432/ajocloud?schema=public
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://ajocloud:local_only_change_me@localhost:5672
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
TOKEN_PEPPER=replace-with-at-least-32-random-characters
JWT_REFRESH_TTL_SECONDS=2592000
IDEMPOTENCY_TTL_SECONDS=86400
AWS_REGION=af-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PAYMENT_PROVIDER=mock
BILL_PAYMENT_PROVIDER=mock
DEFAULT_CURRENCY=NGN
APPLICATION_TIMEZONE=Africa/Lagos
MONNIFY_BASE_URL=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WEBHOOK_SECRET=
# Accept Monnify webhooks. Requires MONNIFY_WEBHOOK_SECRET: there is no way to
# run these routes without signature verification, because they are public URLs
# that carry money instructions. See ADR-006.
MONNIFY_WEBHOOKS_ENABLED=false
# Let a sandbox-limited verification failure fall back to the mock provider so
# mobile testing is not blocked by test keys. Every fallback result is flagged
# SANDBOX_FALLBACK and attributed to the mock. Refused in production.
KYC_SANDBOX_FALLBACK=false
# Monnify is the single provider for payments, verification, and payouts.
# Set KYC_PROVIDER=monnify together with the MONNIFY_* values above; otherwise
# the mock provider is used and never reports a real-world identity as
# verified. See ADR-005.
KYC_PROVIDER=mock
# Google sign-in. Leave the whole block unset to disable it (routes return 404).
# Callback must be registered verbatim in the Google Cloud console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Where the browser lands after a successful web sign-in.
# GOOGLE_WEB_SUCCESS_URL=http://localhost:3001/admin
# Mobile deep link; must match the app scheme.
# GOOGLE_MOBILE_SUCCESS_URL=ajocloud:///auth/google

# Email delivery: console (logs only) or resend
EMAIL_PROVIDER=console
RESEND_BASE_URL=
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=Ajo Cloud
# Expo push accepts unauthenticated sends for its own tokens, so no key is needed.
PUSH_PROVIDER=mock
OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_MONITORING_DSN=
SWAGGER_ENABLED=true
