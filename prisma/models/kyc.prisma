model KycProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @db.Uuid
  status       KycStatus @default(NOT_STARTED)
  tier         KycTier   @default(TIER_1)
  level        Int       @default(1)
  providerRef  String?   @unique @db.VarChar(191)
  submittedAt  DateTime? @db.Timestamptz(6)
  verifiedAt   DateTime? @db.Timestamptz(6)
  restrictedAt DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  user        User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  checks      KycCheck[]
  documents   VerificationDocument[]
  coordinator FoodCoordinatorProfile?
  reviews     ComplianceReview[]

  @@map("kyc_profiles")
}

model KycCheck {
  id               String           @id @default(uuid()) @db.Uuid
  kycProfileId     String           @db.Uuid
  type             VerificationType
  provider         String           @db.VarChar(64)
  status           KycCheckStatus   @default(PENDING)
  providerRef      String?          @db.VarChar(191)
  resultCode       String?          @db.VarChar(64)
  maskedIdentifier String?          @db.VarChar(64)
  resultSummary    Json?
  failureReason    String?          @db.VarChar(500)
  riskFlags        Json?
  reviewerUserId   String?          @db.Uuid
  submittedAt      DateTime         @default(now()) @db.Timestamptz(6)
  checkedAt        DateTime?        @db.Timestamptz(6)
  rawDataExpiresAt DateTime?        @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)

  profile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([kycProfileId, type, status])
  @@map("kyc_checks")
}

model VerificationDocument {
  id           String    @id @default(uuid()) @db.Uuid
  kycProfileId String    @db.Uuid
  type         String    @db.VarChar(64)
  storageKey   String    @unique @db.VarChar(500)
  contentHash  String    @db.VarChar(128)
  expiresAt    DateTime? @db.Date
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  profile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Restrict)

  @@map("verification_documents")
}

model VerificationProviderEvent {
  id              String                @id @default(uuid()) @db.Uuid
  provider        String                @db.VarChar(64)
  providerEventId String                @db.VarChar(191)
  payloadHash     String                @db.VarChar(128)
  status          EventProcessingStatus @default(PENDING)
  receivedAt      DateTime              @default(now()) @db.Timestamptz(6)
  processedAt     DateTime?             @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@map("verification_provider_events")
}

model FoodCoordinatorProfile {
  id           String    @id @default(uuid()) @db.Uuid
  kycProfileId String    @unique @db.Uuid
  status       KycStatus @default(PENDING)
  approvedAt   DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  profile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Restrict)

  @@map("food_coordinator_profiles")
}

model ComplianceReview {
  id           String                 @id @default(uuid()) @db.Uuid
  kycProfileId String                 @db.Uuid
  reviewerId   String?                @db.Uuid
  status       ComplianceReviewStatus @default(OPEN)
  reason       String?                @db.VarChar(1000)
  decidedAt    DateTime?              @db.Timestamptz(6)
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)

  profile KycProfile @relation(fields: [kycProfileId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("compliance_reviews")
}
