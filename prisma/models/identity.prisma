model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique @db.VarChar(320)
  phone           String?    @unique @db.VarChar(32)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @db.Timestamptz(6)
  lastLoginAt     DateTime?  @db.Timestamptz(6)
  suspendedAt     DateTime?  @db.Timestamptz(6)
  deactivatedAt   DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  profile                UserProfile?
  credential             UserCredential?
  sessions               Session[]
  devices                Device[]
  roleAssignments        UserRole[]
  organisationMembers    OrganisationMember[]
  kycProfile             KycProfile?
  wallets                Wallet[]
  verificationChallenges AccountVerificationChallenge[]
  consents               UserConsent[]
  identities             UserIdentity[]
  transactionPin         TransactionPin?
  bankAccounts           LinkedBankAccount[]
  staffInvitesSent       StaffInvite[]                  @relation("StaffInvitesSent")
  staffInviteAccepted    StaffInvite[]                  @relation("StaffInviteAccepted")
  adminNotifications     AdminNotification[]            @relation("AdminNotificationTarget")
  adminNotificationReads AdminNotificationRead[]

  @@index([status, createdAt])
  @@map("users")
}

/// A federated sign-in identity (e.g. Google). A user may link several providers,
/// but one provider account maps to exactly one user.
model UserIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  /// Provider's stable subject identifier. Never an email: emails can change.
  providerUserId String           @db.VarChar(191)
  /// Email asserted by the provider at link time, retained for support only.
  email          String?          @db.VarChar(320)
  linkedAt       DateTime         @default(now()) @db.Timestamptz(6)
  lastLoginAt    DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

model AccountVerificationChallenge {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @db.Uuid
  channel           AccountVerificationChannel
  purpose           VerificationPurpose        @default(ACCOUNT_VERIFICATION)
  codeHash          String                     @db.VarChar(128)
  destinationMasked String                     @db.VarChar(191)
  expiresAt         DateTime                   @db.Timestamptz(6)
  resendAvailableAt DateTime                   @db.Timestamptz(6)
  attemptCount      Int                        @default(0)
  maxAttempts       Int                        @default(5)
  consumedAt        DateTime?                  @db.Timestamptz(6)
  invalidatedAt     DateTime?                  @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("account_verification_challenges")
}

model UserConsent {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       ConsentType
  version    String      @db.VarChar(64)
  acceptedAt DateTime    @default(now()) @db.Timestamptz(6)
  ipAddress  String?     @db.Inet

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, version])
  @@index([type, version, acceptedAt])
  @@map("user_consents")
}

model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  firstName   String    @db.VarChar(100)
  lastName    String    @db.VarChar(100)
  otherNames  String?   @db.VarChar(160)
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  /// Residential address collected for Tier 2. Not an identity number: it is
  /// ordinary profile data and is stored in the clear.
  addressLine String?   @db.VarChar(200)
  city        String?   @db.VarChar(100)
  occupation  String?   @db.VarChar(120)
  country     String    @default("NG") @db.Char(2)
  state       String?   @db.VarChar(100)
  avatarUrl   String?   @db.VarChar(2048)
  timezone    String    @default("Africa/Lagos") @db.VarChar(64)
  locale      String    @default("en-NG") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserCredential {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @db.Uuid
  type         CredentialType @default(PASSWORD)
  passwordHash String         @db.VarChar(255)
  changedAt    DateTime       @default(now()) @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

/// A user's transaction PIN, used to authorise money movement in the app.
/// Only an Argon2id digest is stored; the PIN itself is never persisted or logged.
model TransactionPin {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  pinHash     String    @db.VarChar(255)
  /// Consecutive failures since the last success, used to lock the PIN.
  failedCount Int       @default(0)
  /// Set when failures exceed the limit; cleared by a successful reset.
  lockedUntil DateTime? @db.Timestamptz(6)
  lastUsedAt  DateTime? @db.Timestamptz(6)
  changedAt   DateTime  @default(now()) @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transaction_pins")
}

model Device {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  fingerprint String    @db.VarChar(191)
  name        String?   @db.VarChar(120)
  platform    String?   @db.VarChar(64)
  trustedAt   DateTime? @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, fingerprint])
  @@map("devices")
}

model Session {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  deviceId         String?       @db.Uuid
  status           SessionStatus @default(ACTIVE)
  currentTokenHash String        @db.VarChar(128)
  ipAddress        String?       @db.Inet
  userAgent        String?       @db.VarChar(500)
  expiresAt        DateTime      @db.Timestamptz(6)
  lastRotatedAt    DateTime      @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime?     @db.Timestamptz(6)
  revokeReason     String?       @db.VarChar(120)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(128)
  expiresAt    DateTime  @db.Timestamptz(6)
  consumedAt   DateTime? @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}

/// A bank account the user has linked after a successful name inquiry.
/// The account number is not an identity number, but it is still only stored
/// masked plus a digest, so a breach does not yield a usable account list.
/// See ADR-004.
model LinkedBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  /// NIP bank code as supplied by the verification provider.
  bankCode      String   @db.VarChar(16)
  bankName      String   @db.VarChar(120)
  /// Last four digits only, e.g. `******6789`.
  accountMasked String   @db.VarChar(32)
  /// HMAC of the full account number, so the same account can be recognised
  /// without the number being recoverable from the database.
  accountDigest String   @db.VarChar(128)
  /// Name returned by the provider's inquiry, not name entered by the user.
  accountName   String   @db.VarChar(200)
  provider      String   @db.VarChar(64)
  providerRef   String?  @db.VarChar(191)
  verifiedAt    DateTime @default(now()) @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountDigest])
  @@index([userId])
  @@map("linked_bank_accounts")
}
