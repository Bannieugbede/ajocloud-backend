model FeeDefinition {
  id                      String             @id @default(uuid()) @db.Uuid
  code                    String             @db.VarChar(80)
  version                 Int                @default(1)
  name                    String             @db.VarChar(160)
  calculationType         FeeCalculationType
  amountMinor             BigInt?
  basisPoints             Int?
  currency                String?            @db.Char(3)
  minimumMinor            BigInt?
  maximumMinor            BigInt?
  payerType               String             @db.VarChar(64)
  chargeEvent             String             @db.VarChar(80)
  refundable              Boolean            @default(false)
  taxTreatment            String?            @db.VarChar(120)
  /// The provider's own charge on this transaction, used by TIERED pricing so
  /// the platform never sells below cost. Stored as configuration rather than
  /// a constant: provider pricing is unverified (ADR-009), so correcting it is
  /// a seeded, versioned change with an audit trail.
  providerRateBasisPoints Int?
  providerFlatMinor       BigInt?
  effectiveAt             DateTime           @db.Timestamptz(6)
  expiresAt               DateTime?          @db.Timestamptz(6)
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @db.Timestamptz(6)

  assessments FeeAssessment[]
  tiers       FeeTier[]

  @@unique([code, version])
  @@index([code, isActive, effectiveAt])
  @@map("fee_definitions")
}

/// One markup band of a TIERED fee definition.
///
/// Bands are half-open — `fromMinor <= amount < toMinor` — so a boundary amount
/// belongs to exactly one tier. `toMinor` is null on the final, open-ended tier.
/// A definition's tiers are validated to partition the whole range with no gap
/// and no overlap: an off-by-one at a band edge is a money bug that surfaces
/// only in reconciliation. See ADR-009.
model FeeTier {
  id              String  @id @default(uuid()) @db.Uuid
  feeDefinitionId String  @db.Uuid
  fromMinor       BigInt
  toMinor         BigInt?
  amountMinor     BigInt

  definition FeeDefinition @relation(fields: [feeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([feeDefinitionId, fromMinor])
  @@index([feeDefinitionId, fromMinor])
  @@map("fee_tiers")
}

model FeeAssessment {
  id                   String              @id @default(uuid()) @db.Uuid
  feeDefinitionId      String              @db.Uuid
  subjectType          String              @db.VarChar(64)
  subjectId            String              @db.Uuid
  amountMinor          BigInt
  currency             String              @db.Char(3)
  status               FeeAssessmentStatus @default(PENDING)
  ledgerTransactionId  String?             @db.Uuid
  ruleSnapshot         Json
  calculationBaseMinor BigInt?
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)

  definition  FeeDefinition @relation(fields: [feeDefinitionId], references: [id], onDelete: Restrict)
  swapRequest SwapRequest?

  @@index([subjectType, subjectId])
  @@map("fee_assessments")
}
