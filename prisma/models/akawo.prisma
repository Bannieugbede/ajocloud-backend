model SavingsGoal {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  name            String            @db.VarChar(160)
  type            SavingsGoalType   @default(TARGET)
  targetMinor     BigInt
  currency        String            @default("NGN") @db.Char(3)
  status          SavingsGoalStatus @default(DRAFT)
  targetDate      DateTime?         @db.Date
  maturityAt      DateTime?         @db.Timestamptz(6)
  autoSaveEnabled Boolean           @default(false)
  reminderEnabled Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  schedules      SavingsSchedule[]
  contributions  SavingsContribution[]
  withdrawalRule SavingsWithdrawalRule?
  withdrawals    SavingsWithdrawal[]

  @@index([userId, status])
  @@map("savings_goals")
}

model SavingsSchedule {
  id          String                @id @default(uuid()) @db.Uuid
  goalId      String                @db.Uuid
  amountMinor BigInt
  currency    String                @db.Char(3)
  dueAt       DateTime              @db.Timestamptz(6)
  status      SavingsScheduleStatus @default(PENDING)
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@index([goalId, status, dueAt])
  @@map("savings_schedules")
}

model SavingsContribution {
  id                  String        @id @default(uuid()) @db.Uuid
  goalId              String        @db.Uuid
  amountMinor         BigInt
  currency            String        @db.Char(3)
  status              PaymentStatus @default(PENDING)
  idempotencyKey      String        @unique @db.VarChar(128)
  ledgerTransactionId String?       @unique @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@index([goalId, status])
  @@map("savings_contributions")
}

model SavingsWithdrawalRule {
  id         String                    @id @default(uuid()) @db.Uuid
  goalId     String                    @unique @db.Uuid
  type       SavingsWithdrawalRuleType
  unlocksAt  DateTime?                 @db.Timestamptz(6)
  penaltyBps Int                       @default(0)
  createdAt  DateTime                  @default(now()) @db.Timestamptz(6)

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@map("savings_withdrawal_rules")
}

model SavingsWithdrawal {
  id                  String           @id @default(uuid()) @db.Uuid
  goalId              String           @db.Uuid
  amountMinor         BigInt
  penaltyMinor        BigInt           @default(0)
  currency            String           @db.Char(3)
  status              WithdrawalStatus @default(PENDING)
  idempotencyKey      String           @unique @db.VarChar(128)
  ledgerTransactionId String?          @unique @db.Uuid
  requestedAt         DateTime         @default(now()) @db.Timestamptz(6)
  completedAt         DateTime?        @db.Timestamptz(6)

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@index([goalId, status, requestedAt])
  @@map("savings_withdrawals")
}

/// A collection pool: an organiser gathers a fixed amount from named members
/// towards a stated purpose. Distinct from SavingsGoal, which has one owner and
/// no members. See ADR-007.
model AkawoPool {
  id             String          @id @default(uuid()) @db.Uuid
  organiserUserId String         @db.Uuid
  name           String          @db.VarChar(160)
  purpose        String?         @db.VarChar(500)
  /// What each member owes. Every member of a pool owes the same amount; a pool
  /// with per-member amounts would be a different product.
  amountMinor    BigInt
  currency       String          @default("NGN") @db.Char(3)
  status         AkawoPoolStatus @default(DRAFT)
  /// SHA-256 of the join code. The plaintext is shown to the organiser once and
  /// never stored, so an outstanding code cannot be read from a database dump.
  joinCodeDigest String          @unique @db.VarChar(128)
  /// Label for the reference members supply when joining, e.g. "Matric number".
  referenceLabel String          @default("Reference") @db.VarChar(80)
  dueAt          DateTime?       @db.Timestamptz(6)
  closedAt       DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)

  organiser User               @relation(fields: [organiserUserId], references: [id], onDelete: Restrict)
  members   AkawoPoolMember[]
  dues      AkawoPoolDue[]

  @@index([organiserUserId, status])
  @@index([status, createdAt])
  @@map("akawo_pools")
}

/// Membership of a pool. The name and reference are what the member supplies on
/// joining, not their platform profile: an organiser collecting from a class
/// needs the matric number they can reconcile against, and the joiner may have
/// no profile at all.
model AkawoPoolMember {
  id           String                @id @default(uuid()) @db.Uuid
  poolId       String                @db.Uuid
  userId       String                @db.Uuid
  fullName     String                @db.VarChar(160)
  reference    String                @db.VarChar(80)
  status       AkawoPoolMemberStatus @default(ACTIVE)
  joinedAt     DateTime              @default(now()) @db.Timestamptz(6)
  removedAt    DateTime?             @db.Timestamptz(6)

  pool AkawoPool     @relation(fields: [poolId], references: [id], onDelete: Restrict)
  user User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  dues AkawoPoolDue[]

  /// One membership per person per pool.
  @@unique([poolId, userId])
  /// The reference is how the organiser identifies a member, so it must not
  /// repeat within a pool.
  @@unique([poolId, reference])
  @@index([poolId, status])
  @@map("akawo_pool_members")
}

/// What one member owes in one pool. `PAID` is only ever reached by settled
/// ledger movement; nothing may set it directly. See ADR-007.
model AkawoPoolDue {
  id                  String         @id @default(uuid()) @db.Uuid
  poolId              String         @db.Uuid
  memberId            String         @db.Uuid
  amountMinor         BigInt
  currency            String         @default("NGN") @db.Char(3)
  status              AkawoDueStatus @default(PENDING)
  /// Set when the paying ledger transaction posts. Null while unpaid.
  ledgerTransactionId String?        @unique @db.Uuid
  paidAt              DateTime?      @db.Timestamptz(6)
  waivedReason        String?        @db.VarChar(500)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  pool   AkawoPool       @relation(fields: [poolId], references: [id], onDelete: Restrict)
  member AkawoPoolMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  /// One outstanding due per member per pool.
  @@unique([poolId, memberId])
  @@index([poolId, status])
  @@map("akawo_pool_dues")
}
