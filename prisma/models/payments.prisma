model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @db.Uuid
  walletId            String?       @db.Uuid
  internalReference   String        @unique @db.VarChar(80)
  provider            String        @db.VarChar(64)
  providerReference   String?       @unique @db.VarChar(191)
  amountMinor         BigInt
  currency            String        @db.Char(3)
  status              PaymentStatus @default(PENDING)
  idempotencyKey      String        @unique @db.VarChar(128)
  ledgerTransactionId String?       @unique @db.Uuid
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  attempts PaymentAttempt[]

  @@index([userId, status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  paymentId         String        @db.Uuid
  attemptNumber     Int
  providerReference String?       @db.VarChar(191)
  status            PaymentStatus @default(PENDING)
  failureCode       String?       @db.VarChar(64)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNumber])
  @@index([providerReference])
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id              String                @id @default(uuid()) @db.Uuid
  provider        String                @db.VarChar(64)
  providerEventId String                @db.VarChar(191)
  payloadHash     String                @db.VarChar(128)
  signatureHash   String?               @db.VarChar(128)
  status          EventProcessingStatus @default(PENDING)
  failureReason   String?               @db.VarChar(500)
  receivedAt      DateTime              @default(now()) @db.Timestamptz(6)
  processedAt     DateTime?             @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model Withdrawal {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @db.Uuid
  walletId            String           @db.Uuid
  internalReference   String           @unique @db.VarChar(80)
  amountMinor         BigInt
  currency            String           @db.Char(3)
  status              WithdrawalStatus @default(PENDING)
  idempotencyKey      String           @unique @db.VarChar(128)
  providerReference   String?          @unique @db.VarChar(191)
  ledgerTransactionId String?          @unique @db.Uuid
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)

  @@index([userId, status, createdAt])
  @@map("withdrawals")
}

model Transfer {
  id                  String         @id @default(uuid()) @db.Uuid
  sourceWalletId      String         @db.Uuid
  destinationWalletId String         @db.Uuid
  internalReference   String         @unique @db.VarChar(80)
  amountMinor         BigInt
  currency            String         @db.Char(3)
  status              TransferStatus @default(PENDING)
  idempotencyKey      String         @unique @db.VarChar(128)
  ledgerTransactionId String?        @unique @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  @@index([sourceWalletId, createdAt])
  @@index([destinationWalletId, createdAt])
  @@map("transfers")
}

model IdempotencyRecord {
  id           String            @id @default(uuid()) @db.Uuid
  key          String            @db.VarChar(128)
  scope        String            @db.VarChar(100)
  requestHash  String            @db.VarChar(128)
  status       IdempotencyStatus @default(PROCESSING)
  responseCode Int?
  responseBody Json?
  lockedUntil  DateTime?         @db.Timestamptz(6)
  expiresAt    DateTime          @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model ReconciliationRecord {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String    @db.VarChar(64)
  externalReference String    @db.VarChar(191)
  internalReference String?   @db.VarChar(191)
  amountMinor       BigInt
  currency          String    @db.Char(3)
  matched           Boolean   @default(false)
  reconciledAt      DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([provider, externalReference])
  @@index([matched, createdAt])
  @@map("reconciliation_records")
}

model SettlementRecord {
  id                String   @id @default(uuid()) @db.Uuid
  provider          String   @db.VarChar(64)
  providerReference String   @db.VarChar(191)
  amountMinor       BigInt
  feeMinor          BigInt   @default(0)
  currency          String   @db.Char(3)
  settledAt         DateTime @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  @@unique([provider, providerReference])
  @@map("settlement_records")
}

/// A single payment being made for one target, shared by every product.
///
/// `amountMinor` is always resolved server-side from the target and never
/// accepted from the client: a client-supplied amount here would let a member
/// settle a large due for one naira. See ADR-008.
model PaymentIntent {
  id       String              @id @default(uuid()) @db.Uuid
  userId   String              @db.Uuid
  walletId String?             @db.Uuid
  status   PaymentIntentStatus @default(REQUIRES_CONFIRMATION)

  targetType PaymentTargetType
  /// Not a foreign key: the target lives in a different table per type. The
  /// reference is validated inside the settlement transaction instead.
  targetId   String?           @db.Uuid

  amountMinor BigInt
  /// Always 0 until the banded fee model is settled. Persisted rather than
  /// derived so the audit trail records what was actually charged.
  feeMinor    BigInt @default(0)
  totalMinor  BigInt
  currency    String @db.Char(3)

  method            PaymentMethod?
  /// Provider handle for a transfer or card payment; null for wallet payments,
  /// which never leave the ledger.
  providerReference String?        @unique @db.VarChar(191)

  idempotencyKey      String  @db.VarChar(128)
  ledgerTransactionId String? @unique @db.Uuid

  failureReason String?   @db.VarChar(500)
  confirmedAt   DateTime? @db.Timestamptz(6)
  settledAt     DateTime? @db.Timestamptz(6)
  /// An unconfirmed intent stops being payable after this, so a stale screen
  /// cannot settle an amount that has since changed.
  expiresAt     DateTime  @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Scoped to the user so one member's key cannot collide with another's, and
  /// enforced by the database so two concurrent taps cannot both create one.
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([targetType, targetId])
  @@map("payment_intents")
}
