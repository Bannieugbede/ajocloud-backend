/// A notification raised for the admin console.
///
/// The transactional notifications module sends email and SMS to customers and
/// keeps nothing; this is the separate, durable feed staff read in the console.
/// A notification is addressed either to a single staff member (`userId`) or,
/// when that is null, to everyone holding `permission` — so "a KYC profile needs
/// review" reaches whoever is on compliance rather than one named person.
model AdminNotification {
  id       String                @id @default(uuid()) @db.Uuid
  type     AdminNotificationType
  severity AdminNotificationSeverity @default(INFO)
  title    String                @db.VarChar(200)
  body     String                @db.VarChar(1000)

  /// Where the console should send someone acting on this, e.g. "/admin/kyc".
  href String? @db.VarChar(200)

  /// Addressed to one staff member; null means "anyone who may act on it".
  userId String? @db.Uuid
  /// Permission a reader must hold to see a broadcast. Null means any staff.
  permission String? @db.VarChar(100)

  /// Identifies the thing the notification is about (a KYC profile, an inquiry).
  /// Combined with `type` it keeps a recurring condition from being raised twice.
  subjectType String? @db.VarChar(64)
  subjectId   String? @db.Uuid

  /// Set when the underlying work is done, so the feed can drop stale items
  /// without deleting the audit trail.
  resolvedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user  User?                   @relation("AdminNotificationTarget", fields: [userId], references: [id], onDelete: Cascade)
  reads AdminNotificationRead[]

  /// The feed query: unresolved, newest first.
  @@index([resolvedAt, createdAt])
  /// Dedupe lookups for a recurring condition.
  @@unique([type, subjectType, subjectId], name: "admin_notification_subject")
  @@index([userId, createdAt])
  @@map("admin_notifications")
}

/// Per-reader read state. A broadcast is read by one staff member without being
/// marked read for everyone, so this is a join rather than a flag on the parent.
model AdminNotificationRead {
  notificationId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now()) @db.Timestamptz(6)

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("admin_notification_reads")
}

enum AdminNotificationType {
  KYC_REVIEW_PENDING
  COORDINATOR_APPLICATION_PENDING
  SUPPORT_INQUIRY_OPENED
  STAFF_INVITE_PENDING
  WAITLIST_SIGNUP
  SYSTEM
}

enum AdminNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}
