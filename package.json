{
  "name": "ajocloud-backend",
  "version": "0.1.0",
  "description": "Production backend foundation for Ajo Cloud cooperative savings",
  "author": "Ajo Cloud",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/src/main.js",
    "start:worker": "nest start --entryFile workers/worker.main",
    "start:scheduler": "nest start --entryFile scheduler/scheduler.main",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,prisma}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,docs,.github}/**/*.{ts,json,yml,yaml,md}\" \"prisma/seed/**/*.ts\" \"*.{ts,json,md,yml,yaml}\" && prisma format",
    "format:check": "prettier --check \"{src,test,docs,.github}/**/*.{ts,json,yml,yaml,md}\" \"prisma/seed/**/*.ts\" \"*.{ts,json,md,yml,yaml}\" && prisma format --check",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand --passWithNoTests",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:reset:local": "prisma migrate reset",
    "prisma:seed": "bun prisma/seed/index.ts",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "bun run prisma:validate && bun run prisma:generate && bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run test:e2e && bun run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "8.2.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.5",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "amqplib": "0.10.9",
    "argon2": "0.44.0",
    "bullmq": "5.80.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/amqplib": "0.10.7",
    "@types/jest": "29.5.14",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-import-x": "4.16.1",
    "eslint-plugin-prettier": "5.2.2",
    "globals": "17.0.0",
    "jest": "29.7.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.5",
    "prisma": "7.8.0",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
